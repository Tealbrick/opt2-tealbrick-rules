{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tealbrick.com/opt2/contracts/fleet.directory_feed/1.lifecycle.schema.json",
  "title": "fleet.directory_feed/1 with accept agent_handles and lifecycle",
  "description": "v0.1.42 (C230, G-3, RUL-02, FLT-02). Producer: fleet (Governance) op directory_feed. Consumer: rules. Readers validate the answer against this schema; a mismatch is a refusal with an error (never a partial read). Extra members are allowed and ignored (L24); required members and enum values are strict. Handles are canonical (@opt2-tealbrick/manifest normalizeHandle, G-4). Answers carry no email, no Connect identities and no review reasons (C88, FLT-01). Readers MUST also require normalizeHandle(h) === h for every handle (@opt2-tealbrick/manifest; this checks the bech32 checksum the pattern cannot) and refuse the whole answer otherwise. Member kind `contact` refers to contacts[].id (a reader that models people maps it there). Spec 0.1.89 (C380, docs/ACCESS.md): this file adds the optional members a reader gets when it passes accept: agents[].handles (agent_handles), and contacts[].lifecycle, contacts[].floor, agents[].lifecycle, agents[].floor (lifecycle). A Governance that ignores accept omits them, and the answer stays valid.",
  "oneOf": [
    {
      "$ref": "#/$defs/full"
    },
    {
      "$ref": "#/$defs/unchanged"
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "trust": {
      "enum": [
        "unreviewed",
        "trusted",
        "limited",
        "blocked"
      ]
    },
    "handle": {
      "type": "string",
      "pattern": "^(buzz:npub1[qpzry9x8gf2tvdw0s3jn54khce6mua7l]{58}|slack:[UW][A-Z0-9]{2,30}|telegram:-?[1-9][0-9]{0,19})$",
      "description": "Canonical handle (G-4). The pattern is necessary, not sufficient: readers also require normalizeHandle(h) === h."
    },
    "unchanged": {
      "type": "object",
      "required": [
        "v",
        "revision",
        "unchanged"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "unchanged": {
          "const": true
        }
      }
    },
    "full": {
      "type": "object",
      "required": [
        "v",
        "revision",
        "teams",
        "contacts",
        "agents"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "unchanged": {
          "const": false
        },
        "teams": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "required": [
              "id",
              "members"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "members": {
                "type": "array",
                "maxItems": 4000,
                "items": {
                  "type": "object",
                  "required": [
                    "kind",
                    "id"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "agent",
                        "contact"
                      ]
                    },
                    "id": {
                      "$ref": "#/$defs/id"
                    },
                    "role": {
                      "enum": [
                        "member",
                        "lead"
                      ],
                      "default": "member"
                    }
                  }
                }
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            }
          }
        },
        "contacts": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind",
              "status",
              "trust",
              "handles"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "kind": {
                "enum": [
                  "person",
                  "outside_agent"
                ]
              },
              "status": {
                "enum": [
                  "active",
                  "departed"
                ]
              },
              "trust": {
                "$ref": "#/$defs/trust"
              },
              "handles": {
                "type": "array",
                "maxItems": 16,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/handle"
                }
              },
              "lifecycle": {
                "enum": [
                  "not_started",
                  "proposed",
                  "active",
                  "suspended",
                  "leaving",
                  "archived"
                ],
                "description": "Effective lifecycle, computed by Governance. Absent on outside agents."
              },
              "floor": {
                "type": "boolean",
                "description": "true: Rules refuses this entry before any rule. Effective lifecycle not_started, suspended, leaving or archived (not migrated no_card rows), or trust blocked."
              }
            }
          }
        },
        "agents": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "type": "object",
            "required": [
              "id",
              "status",
              "trust",
              "owner"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^agt_[0-9A-HJKMNP-TV-Z]{26}$"
              },
              "status": {
                "enum": [
                  "active",
                  "paused",
                  "removed"
                ]
              },
              "trust": {
                "$ref": "#/$defs/trust"
              },
              "owner": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/id"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "handles": {
                "type": "array",
                "maxItems": 16,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/handle"
                },
                "description": "Present only when the reader passed accept agent_handles. Canonical, sorted, at most 16; [] when none."
              },
              "lifecycle": {
                "enum": [
                  "not_started",
                  "proposed",
                  "active",
                  "suspended",
                  "leaving",
                  "archived"
                ],
                "description": "Effective lifecycle, computed by Governance. Absent on outside agents."
              },
              "floor": {
                "type": "boolean",
                "description": "true: Rules refuses this entry before any rule. Effective lifecycle not_started, suspended, leaving or archived (not migrated no_card rows), or trust blocked."
              }
            }
          }
        }
      }
    }
  }
}
